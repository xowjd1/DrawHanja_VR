    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "2c54b74fcaac4f5596d6ece169a8faa2",
    "m_Group": {
        "m_Id": "4952b6b6f33342089e2fb7a91603f0d6"
    },
    "m_Name": "GetScaledLightmapUV (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -3528.999755859375,
            "y": -6142.0,
