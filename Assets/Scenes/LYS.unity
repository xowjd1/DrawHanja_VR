--- !u!114 &193085608
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 193085606}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a134e9222dd3a241bca036e387f5bec, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogBeforeQuestComplete:
  - "\uAC70\uAE30 \uC9C0\uB098\uAC00\uB294 \uB108! \uADF8\uB798 \uB108! \uC774 \uBAB8
    \uC880 \uB3C4\uC640\uC904 \uC0DD\uAC01 \uC5C6\uC5B4?"
  - "\uC0AC\uC2E4\uC740 \uC800 \uAC15\uB9CC \uAC74\uB108\uBA74 \uB0B4\uAC00 \uD560
    \uC77C\uC774 \uC788\uB294\uB370\u2026 \uD63C\uC790\uC120 \uC880 \uBB34\uB9AC\uB77C\uC11C
    \uB9D0\uC774\uC9C0."
  - "\uB108, \uD798 \uC880 \uC368\uBCF4\uB294 \uD0C0\uC785 \uAC19\uC544 \uBCF4\uC774\uB294\uB370
    \uC5B4\uB54C?"
  - "P:\u25B6 \uC81C\uC548\uC744 \uC218\uB77D\uD55C\uB2E4."
  - "\uC5ED\uC2DC \uC0AC\uB78C \uBCF4\uB294 \uB208\uC740 \uD2C0\uB9AC\uC9C0 \uC54A\uC544!
    \uC790, \uC5BC\uB978 \uB3C4\uC640\uC918. \uB108\uB9CC \uBBFF\uB294\uB2E4?"
  dialogAfterQuestComplete:
  - "\uC640 \uD798\uC774 \uC7A5\uB09C \uC544\uB2CC\uB370? \uC774\uC81C \uAC15\uC744
    \uAC74\uB110 \uC218 \uC788\uACA0\uC5B4."
  - "(\uBC30\uC5D0\uC11C \uAF2C\uB974\uB975 \uC18C\uB9AC\uAC00 \uB09C\uB2E4.)"
  - "P:\u25B6 \uAE30\uBE44\uB2F9\uACE0\uB97C \uAC74\uB0B4\uC900\uB2E4."
  - "\uC624, \uAE30\uBE44\uB2F9\uACE0? \uC798 \uBC1B\uC744\uAC8C."
  - "\uBB50\uC57C, \uC774\uAC70 \uD798\uC774 \uB9C9 \uC19F\uB294\uB370? \uACE0\uB9C8\uC6CC."
  - "P:\u25B6 \uD568\uAED8 \uB3C4\uAE68\uBE44 \uC12C\uC5D0 \uAC00\uB294 \uAC83\uC744
    \uC81C\uC548\uD55C\uB2E4."
  - "\uB3C4\uAE68\uBE44? \uADF8 \uBB34\uC11C\uC6B4 \uB3C4\uAE68\uBE44\uB97C?"
  - "P:\u25B6 \uAC81\uB098\uC11C \uBABB \uC624\uACA0\uC9C0?"
  - "\uBB50? \uB0B4\uAC00 \uAC81\uC774 \uB09C\uB2E4\uACE0? \uC6C3\uAE30\uC9C0 \uB9C8!
    \uADF8\uAE5F \uB3C4\uAE68\uBE44 \uB098 \uD63C\uC790\uC11C\uB3C4 \uD574\uCE58\uC6B8
    \uC218 \uC788\uC5B4!"
  - "\uB3C4\uAE68\uBE44 \uC7A1\uC73C\uB7EC \uAC00\uBCF4\uC790\uACE0!"
  - "(\uB2E4\uB9AC\uB97C \uAC74\uB108\uC790.)"
  triggerNextQuest: 1
  questIndex: 1
  dialogPanel: {fileID: 1352208470}
  dialogText: {fileID: 1554491469}
  nextButton: {fileID: 720203677}
  choiceButton: {fileID: 905756430}
  choiceText: {fileID: 1648800927}
  wallBlocker: {fileID: 1785362718}
