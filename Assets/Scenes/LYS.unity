--- !u!114 &1640212637
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1579296845}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a134e9222dd3a241bca036e387f5bec, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogBeforeQuestComplete:
  - "\uB108, \uB204\uAD6C\uC57C. \uC65C \uC5EC\uAE30 \uC788\uC5B4?"
  - "(\uB9D0\uC740 \uAC70\uCE60\uC9C0\uB9CC \uBAB8\uC744 \uB5A8\uACE0 \uC788\uB2E4.)"
  - "P:\u25B6 \uB108 \uC880 \uCD94\uC6CC \uBCF4\uC774\uB294\uB370..."
  - "\uC2E0\uACBD \uB044\uACE0 \uAC00\uB358 \uAE38\uC774\uB098 \uAC00."
  - "\uC544\uB2C8\uBA74  \uB098\uBB47\uAC00\uC9C0 \uC138 \uAC1C\uB9CC \uC8FC\uC6CC\uC624\uB4E0\uAC00."
  dialogAfterQuestComplete:
  - "\uC9C4\uC9DC \uAD6C\uD574\uC654\uB124?"
  - "\uC88B\uC544. \uB108\uB3C4 \uC5EC\uAE30\uC11C \uBAA8\uB2E5\uBD88 \uCB10\uACE0
    \uAC00."
  - "\uADFC\uB370 \uB098 \uC880 \uBC30\uACE0\uD504\uAC70\uB4E0. \uD639\uC2DC \uBA39\uC744
    \uAC70 \uC788\uC5B4?"
  - "P:\u25B6 \uAE30\uBE44\uB2F9\uACE0\uB97C \uAC74\uB0B4\uC900\uB2E4."
  - "\uBB50\uC57C \uB098\uD55C\uD14C \uC8FC\uB294 \uAC70\uC57C? \uB108 \uC0DD\uAC01\uBCF4\uB2E4
    \uAD1C\uCC2E\uC740 \uB140\uC11D\uC774\uB124. "
  - "\uC774 \uB2F9\uACE0 \uC815\uB9D0 \uB9DB\uC788\uB2E4. \uACE0\uB9C8\uC6CC."
  - "\uADFC\uB370 \uB10C \uC5B4\uB51C \uAC00\uB358 \uC911\uC774\uC57C?"
  - "P:\u25B6 \uB3C4\uAE68\uBE44 \uC12C\uC5D0 \uB300\uD574 \uC598\uAE30\uD55C\uB2E4."
  - "\uB3C4\uAE68\uBE44 \uC12C? \uAC70\uAE38 \uD63C\uC790 \uAC04\uB2E4\uACE0? \uB108\uBB34
    \uC704\uD5D8\uD55C\uB370..."
  - "\uBB50 \uACE0\uB9C8\uC6B4 \uAC83\uB3C4 \uC788\uACE0... \uB098\uB3C4 \uD568\uAED8\uD560\uAC8C.
    \uC55E\uC7A5 \uC11C."
  triggerNextQuest: 1
  questIndex: 0
  dialogPanel: {fileID: 1632903057}
  dialogText: {fileID: 1291525498}
  nextButton: {fileID: 220932866}
  choiceButton: {fileID: 905756430}
  choiceText: {fileID: 1648800927}
  wallBlocker: {fileID: 0}
