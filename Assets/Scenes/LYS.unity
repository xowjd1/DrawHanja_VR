  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a134e9222dd3a241bca036e387f5bec, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogBeforeQuestComplete:
  - "\uC548\uB155. \uC774\uACF3\uC5D0 \uC0AC\uB78C\uC774 \uC9C0\uB098\uB2E4\uB2C8\uB294
    \uAC74 \uD754\uCE58 \uC54A\uC740\uB370, \uC5B4\uB514 \uAC00\uB294 \uAE38\uC774\uC57C?"
  - "P:\u25B6 \uB3C4\uAE68\uBE44 \uC12C\uC5D0 \uB300\uD574 \uC598\uAE30\uD55C\uB2E4."
  - "\uB108 \uC6A9\uAC10\uD55C \uC544\uC774\uAD6C\uB098. \uB0B4\uAC00 \uB3C4\uC6C0\uC744
    \uC904 \uC218 \uC788\uC744 \uAC83 \uAC19\uC740\uB370..."
  - "\uC800\uAE30 \uBC30 \uD55C \uCC99 \uBCF4\uC5EC? \uC8FC\uC778 \uC5C6\uB294 \uBC30\uB77C
    \uB0B4\uAC00 \uC7AC\uBBF8 \uC0BC\uC544 \uC218\uB9AC\uD574\uB1A8\uC5B4."
  - "\uC800\uAC78 \uD0C0\uACE0 \uBC14\uB2E4\uB85C \uB098\uAC00\uBA74, \uB3C4\uAE68\uBE44
    \uC12C\uC73C\uB85C \uAC08 \uC218 \uC788\uC744 \uAC70\uC57C."
  - "P:\u25B6 \uACE0\uB9C8\uC6C0\uC758 \uD45C\uC2DC\uB85C \uAE30\uBE44\uB2F9\uACE0\uB97C
    \uAC74\uB0B8\uB2E4."
  - "\uC640, \uC774 \uB2F9\uACE0 \uC815\uB9D0 \uB9DB\uC788\uB294\uB370? \uAC12\uC744
    \uD574\uC57C\uACA0\uB294 \uAC78."
  - "\uB098\uB3C4 \uB124 \uC5EC\uC815\uC5D0 \uB3D9\uCC38\uD560\uAC8C. \uAC19\uC774
    \uBC30\uB97C \uD0C0\uACE0 \uB3C4\uAE68\uBE44 \uC12C\uC73C\uB85C \uAC00\uC790!"
