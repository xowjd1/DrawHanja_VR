--- !u!114 &1564078305
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1564078300}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 85c86d5d92b745d49a68bee35e4b854e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  imageDisplay: {fileID: 1020138683}
  storyText: {fileID: 725837854}
  images:
  - {fileID: 21300000, guid: b106be794c5e27641bcb08d8dc4eee72, type: 3}
  - {fileID: 21300000, guid: 26faed103aa9da64b92c8842e4b8e17c, type: 3}
  - {fileID: 21300000, guid: 2d0f00f7b26083d4bbfb8815c78204cd, type: 3}
  - {fileID: 21300000, guid: f398846d1bbc81c4685f44c439143f9a, type: 3}
  texts:
  - "\uC61B\uB0A0 \uC61B\uC801, \uCC29\uD55C \uD560\uC544\uBC84\uC9C0\uC640\\n\uD560\uBA38\uB2C8\uAC00
    \uC0B4\uACE0 \uC788\uC5C8\uC5B4\uC694.\\n\uC5B4\uB290 \uB0A0, \uD560\uBA38\uB2C8\uAC00\\n\uAC1C\uC6B8\uAC00\uC5D0\uC11C
    \uBE68\uB798\uB97C \uD558\uB2E4\uAC00\\n\uAC15\uBB3C \uC704\uB85C \uB5A0\uB0B4\uB824\uC624\uB294\\n\uCEE4\uB2E4\uB780
    \uBCF5\uC22D\uC544\uB97C \uBC1C\uACAC\uD588\uC5B4\uC694. "
  - "\uC9D1\uC5D0 \uB3CC\uC544\uC628 \uD560\uBA38\uB2C8\uAC00\\n\uBCF5\uC22D\uC544\uB97C
    \uC790\uB974\uB824\uB294 \uC21C\uAC04\\n\uBCF5\uC22D\uC544\uAC00 \uAC08\uB77C\uC9C0\uBA70
    \\n\uADF8 \uC548\uC5D0\uC11C \uC0AC\uB0B4\uC544\uC774\uAC00 \uB098\uC654\uC5B4\uC694.\\n\uD560\uC544\uBC84\uC9C0\uC640
    \uD560\uBA38\uB2C8\uB294 \uC544\uC774\uC5D0\uAC8C\\n\u2018\uBAA8\uBAA8\uD0C0\uB85C\u2019\uB77C\uB294
    \uC774\uB984\uC744 \uBD99\uC5EC\uC8FC\uC5C8\uB2F5\uB2C8\uB2E4."
  - "\uBD80\uBD80\uC758 \uC0AC\uB791\uC744 \uBC1B\uC73C\uBA70 \uC790\uB780 \uBAA8\uBAA8\uD0C0\uB85C\uB294\\n\uC5B4\uB290
    \uB0A0, \uB9C8\uC744\uC744 \uAD34\uB86D\uD788\uB294\\n\uB3C4\uAE68\uBE44\uB4E4\uC758
    \uC18C\uBB38\uC744 \uB4E3\uAC8C \uB418\uC5C8\uC5B4\uC694.\\n\uBAA8\uBAA8\uD0C0\uB85C\uB294
    \uC0AC\uB78C\uB4E4\uC744 \uC9C0\uD0A4\uAE30 \uC704\uD574\\n\uB3C4\uAE68\uBE44\uB97C
    \uBB3C\uB9AC\uCE58\uAE30\uB85C \uB9C8\uC74C\uC744 \uBA39\uC5C8\uC5B4\uC694."
  - "\uD560\uBA38\uB2C8\uB294 \uC815\uC131\uAECF \uB9CC\uB4E0 \uB2F9\uACE0\uB97C\\n\uC190\uC5D0
    \uC950\uC5EC\uC8FC\uBA70 \uB9D0\uD588\uC5B4\uC694.\\n\u201C\uC774 \uB2F9\uACE0\uB294
    \uB108\uC5D0\uAC8C \uD798\uC774 \uB418\uC5B4\uC904 \uAC70\uB780\uB2E4.\u201D\\n\uBAA8\uBAA8\uD0C0\uB85C\uB294
    \uAC80\uACFC \uB2F9\uACE0\uB97C \uCC59\uACA8,\\n\uB3C4\uAE68\uBE44\uC12C\uC744
    \uD5A5\uD574 \uC6A9\uAC10\uD558\uAC8C \uAE38\uC744 \uB098\uC130\uC5B4\uC694."
  storyCube: {fileID: 1871079902}
  pageDelay: 5
